{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "toktik",
    "tdsl"
  ],
  "name": "Toktik DSL",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "builtins": {
      "patterns": [
        {
          "match": "\\b(?:alpha|array|candidates|config|contract|event|group|input|leg|market|math|options|order|portfolio|ref|request|schedule|signal|spread|str|strategy|ta|trace|universe)\\b",
          "name": "support.namespace.toktik-dsl"
        },
        {
          "match": "\\b(?:alpha\\s*\\.\\s*decay_linear|alpha\\s*\\.\\s*log_return|alpha\\s*\\.\\s*rank|alpha\\s*\\.\\s*scale|alpha\\s*\\.\\s*signed_power|alpha\\s*\\.\\s*ts_argmax|alpha\\s*\\.\\s*ts_argmin|alpha\\s*\\.\\s*ts_corr|alpha\\s*\\.\\s*ts_cov|alpha\\s*\\.\\s*ts_delta|alpha\\s*\\.\\s*ts_kurtosis|alpha\\s*\\.\\s*ts_max|alpha\\s*\\.\\s*ts_mean|alpha\\s*\\.\\s*ts_median|alpha\\s*\\.\\s*ts_min|alpha\\s*\\.\\s*ts_rank|alpha\\s*\\.\\s*ts_skewness|alpha\\s*\\.\\s*ts_std|alpha\\s*\\.\\s*ts_sum|alpha\\s*\\.\\s*zscore|array\\s*\\.\\s*contains|bar_index|buy|candidates\\s*\\.\\s*add|candidates\\s*\\.\\s*contains_symbol|candidates\\s*\\.\\s*new|candidates\\s*\\.\\s*payload|candidates\\s*\\.\\s*score|candidates\\s*\\.\\s*secondary_score|candidates\\s*\\.\\s*sort|candidates\\s*\\.\\s*symbol|candidates\\s*\\.\\s*take|close|close_raw|config\\s*\\.\\s*get|config\\s*\\.\\s*string|contract\\s*\\.\\s*ask|contract\\s*\\.\\s*bid|contract\\s*\\.\\s*delta|contract\\s*\\.\\s*dte|contract\\s*\\.\\s*expiry|contract\\s*\\.\\s*gamma|contract\\s*\\.\\s*iv|contract\\s*\\.\\s*mark|contract\\s*\\.\\s*market|contract\\s*\\.\\s*oi|contract\\s*\\.\\s*strike|contract\\s*\\.\\s*symbol|contract\\s*\\.\\s*theta|contract\\s*\\.\\s*type|contract\\s*\\.\\s*underlying|contract\\s*\\.\\s*vega|contract\\s*\\.\\s*volume|event\\s*\\.\\s*consume_all|event\\s*\\.\\s*is_add|event\\s*\\.\\s*is_close|event\\s*\\.\\s*is_init|event\\s*\\.\\s*is_roll|event\\s*\\.\\s*next|event\\s*\\.\\s*next_action|event\\s*\\.\\s*peek|event\\s*\\.\\s*peek_action|event\\s*\\.\\s*peek_name|event\\s*\\.\\s*peek_qty|event\\s*\\.\\s*pending|group\\s*\\.\\s*add_spread|group\\s*\\.\\s*close|group\\s*\\.\\s*get|group\\s*\\.\\s*increment_roll|group\\s*\\.\\s*open|group\\s*\\.\\s*open_ids|group\\s*\\.\\s*spread_count|high|high_raw|input|input\\s*\\.\\s*bool|input\\s*\\.\\s*float|input\\s*\\.\\s*int|input\\s*\\.\\s*string|leg\\s*\\.\\s*buy|leg\\s*\\.\\s*sell|len|low|low_raw|market\\s*\\.\\s*context|market\\s*\\.\\s*hv_state|market\\s*\\.\\s*iv_state|market\\s*\\.\\s*reason_codes|market\\s*\\.\\s*risk_label|market\\s*\\.\\s*scenario_label|market\\s*\\.\\s*trend_state|market\\s*\\.\\s*valuation_state|market\\s*\\.\\s*warnings|math\\s*\\.\\s*abs|math\\s*\\.\\s*avg|math\\s*\\.\\s*ceil|math\\s*\\.\\s*exp|math\\s*\\.\\s*floor|math\\s*\\.\\s*log|math\\s*\\.\\s*log10|math\\s*\\.\\s*max|math\\s*\\.\\s*min|math\\s*\\.\\s*pow|math\\s*\\.\\s*round|math\\s*\\.\\s*sign|math\\s*\\.\\s*sqrt|math_e|math_phi|math_pi|na|nz|open|open_raw|options\\s*\\.\\s*best_spread|options\\s*\\.\\s*build_strategy|options\\s*\\.\\s*calls|options\\s*\\.\\s*chain|options\\s*\\.\\s*delta_range|options\\s*\\.\\s*expiry_max|options\\s*\\.\\s*expiry_min|options\\s*\\.\\s*expiry_nearest|options\\s*\\.\\s*expiry_range|options\\s*\\.\\s*len|options\\s*\\.\\s*min_premium|options\\s*\\.\\s*open_strategy|options\\s*\\.\\s*puts|options\\s*\\.\\s*sort_by_delta|options\\s*\\.\\s*strategies|options\\s*\\.\\s*strike_range|order\\s*\\.\\s*buy|order\\s*\\.\\s*immediate|order\\s*\\.\\s*limit|order\\s*\\.\\s*market|order\\s*\\.\\s*market_notional|order\\s*\\.\\s*sell|order\\s*\\.\\s*stop|order\\s*\\.\\s*stop_limit|order\\s*\\.\\s*submit|order\\s*\\.\\s*twap|plot|portfolio\\s*\\.\\s*items|portfolio\\s*\\.\\s*len|portfolio\\s*\\.\\s*symbol|portfolio\\s*\\.\\s*symbols|portfolio\\s*\\.\\s*weight|portfolio\\s*\\.\\s*weights|ref\\s*\\.\\s*clear|ref\\s*\\.\\s*dec|ref\\s*\\.\\s*get|ref\\s*\\.\\s*has|ref\\s*\\.\\s*inc|ref\\s*\\.\\s*set|request\\s*\\.\\s*factor|request\\s*\\.\\s*fundamental|request\\s*\\.\\s*security|schedule\\s*\\.\\s*close_group|schedule\\s*\\.\\s*close_leg|schedule\\s*\\.\\s*close_spread|sell|signal\\s*\\.\\s*action|signal\\s*\\.\\s*active|signal\\s*\\.\\s*consume|signal\\s*\\.\\s*consumed|signal\\s*\\.\\s*count|signal\\s*\\.\\s*direction|signal\\s*\\.\\s*group_ref|signal\\s*\\.\\s*name|signal\\s*\\.\\s*qty|signal\\s*\\.\\s*ref|signal\\s*\\.\\s*remarks|signal\\s*\\.\\s*source|spread\\s*\\.\\s*close|spread\\s*\\.\\s*close_leg|spread\\s*\\.\\s*count|spread\\s*\\.\\s*get|spread\\s*\\.\\s*leg_contract|spread\\s*\\.\\s*leg_entry_price|spread\\s*\\.\\s*leg_open|spread\\s*\\.\\s*leg_qty|spread\\s*\\.\\s*leg_side|spread\\s*\\.\\s*open|spread\\s*\\.\\s*open_ids|spread\\s*\\.\\s*open_in_group|spread\\s*\\.\\s*open_in_group_on|spread\\s*\\.\\s*open_on|spread\\s*\\.\\s*pnl|spread\\s*\\.\\s*pnl_all|str\\s*\\.\\s*contains|str\\s*\\.\\s*format|str\\s*\\.\\s*join|str\\s*\\.\\s*length|str\\s*\\.\\s*lower|str\\s*\\.\\s*split|str\\s*\\.\\s*tostring|str\\s*\\.\\s*upper|strategy\\s*\\.\\s*cash|strategy\\s*\\.\\s*close|strategy\\s*\\.\\s*entry|strategy\\s*\\.\\s*equity|strategy\\s*\\.\\s*exit|strategy\\s*\\.\\s*long|strategy\\s*\\.\\s*position_avg_price|strategy\\s*\\.\\s*position_size|strategy\\s*\\.\\s*short|ta\\s*\\.\\s*atr|ta\\s*\\.\\s*barssince|ta\\s*\\.\\s*bb|ta\\s*\\.\\s*bb_lower|ta\\s*\\.\\s*bb_upper|ta\\s*\\.\\s*cci|ta\\s*\\.\\s*change|ta\\s*\\.\\s*crossover|ta\\s*\\.\\s*crossunder|ta\\s*\\.\\s*cum|ta\\s*\\.\\s*ema|ta\\s*\\.\\s*highest|ta\\s*\\.\\s*lowest|ta\\s*\\.\\s*percentrank|ta\\s*\\.\\s*percentrank_valid|ta\\s*\\.\\s*rsi|ta\\s*\\.\\s*sma|ta\\s*\\.\\s*stdev|ta\\s*\\.\\s*valuewhen|ta\\s*\\.\\s*wma|trace\\s*\\.\\s*emit|universe\\s*\\.\\s*symbols|volume)\\b",
          "name": "support.function.toktik-dsl"
        },
        {
          "match": "\\b(?:cash|equity|position_avg_price|position_size)\\b",
          "name": "support.variable.property.toktik-dsl"
        },
        {
          "match": "\\b(?:bar_index|buy|close|close_raw|high|high_raw|long|low|low_raw|math_e|math_phi|math_pi|open|open_raw|sell|short|volume)\\b",
          "name": "constant.language.toktik-dsl"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.toktik-dsl"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.toktik-dsl"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(?:strategy|indicator|library)\\s*\\(\\s*([\"']).*?\\1",
          "name": "meta.declaration.toktik-dsl"
        },
        {
          "match": "\\b(?:var|varip|export|method)\\b",
          "name": "storage.modifier.toktik-dsl"
        },
        {
          "match": "\\b(?:int|float|bool|string|color|series|simple|const)\\b",
          "name": "storage.type.toktik-dsl"
        }
      ]
    },
    "keywords": {
      "match": "\\b(?:and|bool|break|by|color|const|continue|else|export|false|float|fn|for|if|import|in|indicator|input|int|library|method|na|not|or|return|series|simple|strategy|string|switch|to|true|var|varip|while)\\b",
      "name": "keyword.control.toktik-dsl"
    },
    "numbers": {
      "match": "\\b(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.toktik-dsl"
    },
    "operators": {
      "match": "=\u003e|:=|\\+\\+|--|[+\\-*/%]=?|==|!=|\u003c=|\u003e=|[\u003c\u003e?:=]",
      "name": "keyword.operator.toktik-dsl"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.toktik-dsl",
          "patterns": [
            {
              "match": "\\\\[ntr\\\\\"']",
              "name": "constant.character.escape.toktik-dsl"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.toktik-dsl",
          "patterns": [
            {
              "match": "\\\\[ntr\\\\\"']",
              "name": "constant.character.escape.toktik-dsl"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.toktik-dsl"
}
