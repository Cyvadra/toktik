//@version=6
strategy("VRP Short Strangle")

// ============================================================
// VRP 收割：訊號調控的 SPY 做空跨式
// edge：隱含波動率長期高於實現波動率（volatility risk premium）
// 進場：IV rank 適中 + IV/HV 比例夠高（權利金夠貴）
// 出場：止盈 / 停損 / 到期 / 觸價 / regime 反轉 / 極端 IV
// ============================================================

// ---- 訊號 ----
entry_iv_rank_min = input.float(30.0, "Min IV Rank", 0.0, 100.0, 1.0)
entry_iv_rank_max = input.float(92.0, "Max IV Rank", 0.0, 100.0, 1.0)
panic_flat_rank   = input.float(95.0, "Panic Flat IV Rank", 0.0, 100.0, 1.0)
vrp_min           = input.float(1.05, "Min IV/HV Ratio", 0.5, 3.0, 0.05)
vrp_kill          = input.float(1.00, "Regime Kill IV/HV", 0.5, 2.0, 0.05)

// ---- 結構 ----
target_dte = input.int(30, "Target DTE", 7, 90, 1)
min_dte    = input.int(14, "Exit Below DTE", 1, 60, 1)
put_delta  = input.float(-0.20, "Put Target Delta", -0.45, -0.05, 0.01)
call_delta = input.float(0.20, "Call Target Delta", 0.05, 0.45, 0.01)
qty        = input.int(1, "Contracts", 1, 100, 1)

// ---- 偏斜 ----
skew_adjust = input.bool(true, "Skew Adjust")
skew_widen  = input.float(0.05, "Skew Widen Delta", 0.0, 0.15, 0.01)
skew_thresh = input.float(0.05, "Skew Threshold", 0.0, 0.20, 0.01)

// ---- 出場 ----
take_profit_pct = input.float(0.50, "Take Profit %", 0.10, 1.0, 0.05)
stop_loss_mult  = input.float(2.0, "Stop Loss Multiple", 0.5, 5.0, 0.1)
cooldown_bars   = input.int(3, "Re-entry Cooldown", 0, 20, 1)

// ---- 波動率特徵（主標的 SPY）----
iv      = request.factor("volatility", "1d", "iv")
hv20    = request.factor("volatility", "1d", "hv20")
iv_rank = request.factor("volatility", "1d", "iv_rank")

vrp = iv / hv20

regime_ok = not na(iv_rank) and not na(vrp) and iv_rank >= entry_iv_rank_min and iv_rank <= entry_iv_rank_max and vrp >= vrp_min

// ---- 管理既有部位 ----
if ref.has("spread_id")
    sid = ref.get("spread_id")
    pnl = spread.pnl(sid)
    put_c = spread.leg_contract(sid, 0)
    call_c = spread.leg_contract(sid, 1)
    tp_target = ref.get("tp_target")
    sl_target = ref.get("sl_target")

    exit_tp     = not na(pnl) and not na(tp_target) and pnl >= tp_target
    exit_sl     = not na(pnl) and not na(sl_target) and pnl <= sl_target
    exit_time   = not na(put_c) and contract.dte(put_c) <= min_dte
    exit_breach = (not na(put_c) and close < contract.strike(put_c)) or (not na(call_c) and close > contract.strike(call_c))
    exit_regime = not na(vrp) and vrp < vrp_kill
    exit_panic  = not na(iv_rank) and iv_rank >= panic_flat_rank

    if exit_tp or exit_sl or exit_time or exit_breach or exit_regime or exit_panic
        spread.close(sid, "exit")
        ref.clear("spread_id")
        ref.set("cooldown", cooldown_bars)

// ---- 開新倉 ----
cooldown_left = nz(ref.get("cooldown"), 0)

if not ref.has("spread_id") and regime_ok and cooldown_left <= 0 and bar_index > 30
    chain = options.chain("us", "SPY")
    exp_chain = options.expiry_nearest(chain, target_dte)

    if options.len(exp_chain) > 0
        puts = options.puts(exp_chain)
        calls = options.calls(exp_chain)

        // 偏斜調控：put 端 IV 明顯高於 call 端（負 skew）時，把 put 腿推更 OTM
        adj_put_delta = put_delta
        if skew_adjust
            put25 = options.sort_by_delta(puts, -0.25)
            call25 = options.sort_by_delta(calls, 0.25)
            if len(put25) > 0 and len(call25) > 0
                skew = contract.iv(put25[0]) - contract.iv(call25[0])
                if not na(skew) and skew > skew_thresh
                    adj_put_delta = put_delta + skew_widen

        put_cands = options.delta_range(puts, -0.45, -0.05)
        call_cands = options.delta_range(calls, 0.05, 0.45)
        put_sorted = options.sort_by_delta(put_cands, adj_put_delta)
        call_sorted = options.sort_by_delta(call_cands, call_delta)

        if len(put_sorted) > 0 and len(call_sorted) > 0
            put_c = put_sorted[0]
            call_c = call_sorted[0]
            credit = (nz(contract.bid(put_c), 0.0) + nz(contract.bid(call_c), 0.0)) * 100 * qty

            if not na(put_c) and not na(call_c) and credit > 0
                sid = spread.open([leg.sell(put_c, qty), leg.sell(call_c, qty)], "vrp_strangle")
                if not na(sid) and sid >= 0
                    ref.set("spread_id", sid)
                    ref.set("tp_target", credit * take_profit_pct)
                    ref.set("sl_target", -credit * stop_loss_mult)

// ---- cooldown 遞減 ----
if nz(ref.get("cooldown"), 0) > 0
    ref.set("cooldown", nz(ref.get("cooldown"), 0) - 1)

// ---- 診斷 ----
plot(iv, title="IV", precision=4)
plot(hv20, title="HV20", precision=4)
plot(vrp, title="VRP", precision=4)
plot(iv_rank, title="IV Rank", precision=2)