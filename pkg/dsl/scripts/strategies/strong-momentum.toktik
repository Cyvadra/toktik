//@version=6
strategy("strong-momentum-dsl")

target_delta = input.float(0.35, title="Target Delta", minval=0.05, maxval=0.60, step=0.01)
qty = input.float(1, title="Contracts", minval=1, maxval=20, step=1)
min_dte = input.int(25, title="Minimum DTE", minval=1, maxval=90)
target_dte = input.int(45, title="Target DTE", minval=7, maxval=120)
max_dte = input.int(65, title="Maximum DTE", minval=10, maxval=180)
min_short_premium = input.float(0.50, title="Minimum Short Premium", minval=0, maxval=20, step=0.05)
seller_iv_floor = input.float(70, title="Seller IV Percentile Floor", minval=0, maxval=100, step=1)

symbols = universe.symbols("strong_momentum")
candidate_items = []

for symbol in symbols
    price = request.security("us-stocks", symbol, "1d", "close")
    rsi14 = request.security("us-stocks", symbol, "1d", ta.rsi(close, 14))
    cci20 = request.security("us-stocks", symbol, "1d", ta.cci(high, low, close, 20))
    sma5 = request.security("us-stocks", symbol, "1d", ta.sma(close, 5))
    sma20 = request.security("us-stocks", symbol, "1d", ta.sma(close, 20))
    return20 = request.security("us-stocks", symbol, "1d", close / close[20] - 1)
    hv20 = request.factor("volatility", symbol, "1d", "hv20")
    iv_percentile = request.factor("volatility", symbol, "1d", "iv_percentile")
    hv_percentile = ta.percentrank_valid(hv20, 252, 60)
    data_ready = not na(price) and price > 0 and not na(rsi14) and not na(cci20) and not na(sma5) and not na(sma20) and not na(return20) and not na(hv_percentile) and not na(iv_percentile)
    momentum_ok = data_ready and sma5 > sma20 and rsi14 >= 55 and cci20 > 0 and return20 > 0
    if momentum_ok
        strategy_name = iv_percentile >= seller_iv_floor ? "BULL_PUT_SPREAD" : "BULL_CALL_SPREAD"
        candidate_items = candidates.add(candidate_items, candidates.new(symbol, rsi14, -return20, [price, rsi14, cci20, hv_percentile, iv_percentile, strategy_name]))

ranked = candidates.sort(candidate_items, "desc")
targets = ranked
top_payload = len(targets) > 0 ? candidates.payload(targets[0]) : [na, na, na, na, na, ""]
top_price = top_payload[0]
top_rsi14 = top_payload[1]
top_hv_percentile = top_payload[3]
top_iv_percentile = top_payload[4]

selected_with_strategy = 0
chain_ready_count = 0
legs_ready_count = 0
opened_spreads = 0
closed_out_of_universe = 0

plot(len(symbols), title="universe_size", precision=0)
plot(len(candidate_items), title="qualified_candidates", precision=0)
plot(len(targets), title="momentum_candidates", precision=0)
plot(top_price, title="top_price", precision=2)
plot(top_rsi14, title="top_rsi14", precision=2)
plot(top_hv_percentile, title="top_hv_percentile", precision=2)
plot(top_iv_percentile, title="top_iv_percentile", precision=2)

for spread_id in spread.open_ids()
    leg = spread.leg_contract(spread_id, 0)
    underlying = contract.underlying(leg)
    if str.length(underlying) > 0 and not array.contains(symbols, underlying)
        spread.close(spread_id, "left_strong_momentum_universe")
        ref.clear(str.format("strong_momentum_%s", underlying))
        closed_out_of_universe += 1
        trace.emit("momentum_close_out_of_universe", underlying, "membership")

opened_this_bar = false
for item in targets
    if not opened_this_bar
        symbol = candidates.symbol(item)
        payload = candidates.payload(item)
        strategy_name = payload[5]
        state_key = str.format("strong_momentum_%s", symbol)
        if ref.has(state_key)
            existing = spread.get(ref.get(state_key))
            if len(existing) < 5 or not existing[4]
                ref.clear(state_key)

        if str.length(strategy_name) > 0 and not ref.has(state_key)
            selected_with_strategy += 1
            chain = options.chain("us-options", symbol)
            chain = options.expiry_range(chain, min_dte, max_dte)
            chain = options.expiry_nearest(chain, target_dte)
            if options.len(chain) > 0
                chain_ready_count += 1
                legs = options.build_strategy(chain, strategy_name, qty, target_delta)
                if len(legs) > 0
                    short_premium_ok = strategy_name != "BULL_PUT_SPREAD" or contract.bid(legs[1][0]) >= min_short_premium
                    if short_premium_ok
                        legs_ready_count += 1
                        spread_id = spread.open_on("us-options", symbol, legs, "strong-momentum")
                        if spread_id >= 0
                            ref.set(state_key, spread_id)
                            opened_spreads += 1
                            opened_this_bar = true
                            trace.emit("momentum_open", symbol, strategy_name)
                        else
                            trace.emit("momentum_open_rejected", symbol, strategy_name)
                    else
                        trace.emit("momentum_premium_rejected", symbol, strategy_name)
                else
                    trace.emit("momentum_legs_empty", symbol, strategy_name)
            else
                trace.emit("momentum_chain_empty", symbol, strategy_name)

plot(selected_with_strategy, title="selected_with_strategy", precision=0)
plot(chain_ready_count, title="chain_ready_count", precision=0)
plot(legs_ready_count, title="legs_ready_count", precision=0)
plot(opened_spreads, title="opened_spreads", precision=0)
plot(closed_out_of_universe, title="closed_out_of_universe", precision=0)
plot(spread.count(), title="open_spreads", precision=0)