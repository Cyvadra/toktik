//@version=6
strategy("us-option-iv-ridge-trend")

// The option IV ridge is a directional input, not a standalone fair value.
// A long-only core captures the underlying risk premium. Confirmed ridge
// displacement rotates the core into a tactical long or short position until
// the ridge converges, the direction invalidates, or risk limits are reached.

symbol = input.string("SPY", title="Symbol")
min_dte = input.int(20, title="Minimum DTE", minval=0)
max_dte = input.int(120, title="Maximum DTE", minval=1)
min_expiries = input.int(3, title="Minimum Expiries", minval=1)
ridge_contract_count = input.int(5, title="Ridge Contracts Per Expiry", minval=3)
ridge_entry_percent = input.float(2, title="Ridge Entry Percent", minval=0.2, step=0.1)
ridge_exit_percent = input.float(0.4, title="Ridge Exit Percent", minval=0, step=0.1)
fast_len = input.int(20, title="Fast EMA Length", minval=2)
slow_len = input.int(100, title="Slow EMA Length", minval=20)
rsi_len = input.int(14, title="RSI Length", minval=2)
core_equity_percent = input.float(80, title="Core Equity Percent", minval=10, maxval=100)
max_hold_bars = input.int(15, title="Maximum Ridge Holding Bars", minval=2)

fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi = ta.rsi(close, rsi_len)
trend_up = not na(slow_ema) and close > slow_ema and fast_ema > slow_ema
trend_down = not na(slow_ema) and close < slow_ema and fast_ema < slow_ema

chain = options.chain("us", symbol)
ridge_strikes = []

if chain != na
    eligible_chain = options.expiry_range(chain, min_dte, max_dte)
    expirations = options.expirations(eligible_chain)
    for expiration in expirations
        expiry_chain = options.expiry(eligible_chain, expiration)
        low_iv_contracts = options.lowest_iv(expiry_chain, ridge_contract_count)
        if len(low_iv_contracts) > 0
            expiry_ridge_strikes = []
            for ridge_contract in low_iv_contracts
                expiry_ridge_strikes = expiry_ridge_strikes + [contract.strike(ridge_contract)]
            ridge_strikes = ridge_strikes + [array.percentile(expiry_ridge_strikes, 50)]

ridge = array.percentile(ridge_strikes, 50)
ridge_gap_percent = close > 0 ? (ridge - close) / close * 100 : na
ridge_ready = len(ridge_strikes) >= min_expiries and not na(ridge_gap_percent)

// Two-bar confirmation rejects one-day quote noise. Trend only filters the
// counter-trend short side; bullish ridge reversion remains available broadly.
bullish_ridge = ridge_ready and ridge_gap_percent >= ridge_entry_percent and ridge_gap_percent[1] >= ridge_entry_percent
bearish_ridge = ridge_ready and ridge_gap_percent <= -ridge_entry_percent and ridge_gap_percent[1] <= -ridge_entry_percent
bullish_setup = bullish_ridge
bearish_setup = bearish_ridge and close < fast_ema

varip ridge_direction = 0
varip ridge_holding_bars = 0

if ridge_direction == 0 and bullish_setup
    ridge_direction := 1
    strategy.close(id="core")
else if ridge_direction == 0 and bearish_setup
    ridge_direction := -1
    strategy.close(id="core")

// The engine does not pyramid regular orders on the same underlying. When a
// ridge setup appears, rotate out of the core first, then enter a separate
// tactical trade on the following bar.
if ridge_direction != 0
    if strategy.position_size == 0
        strategy.entry(id="ridge_trade", direction=ridge_direction > 0 ? strategy.long : strategy.short, notional=strategy.equity * core_equity_percent / 100)
    else
        ridge_holding_bars += 1
        ridge_converged = ridge_ready and math.abs(ridge_gap_percent) <= ridge_exit_percent
        ridge_invalid = (ridge_direction > 0 and ridge_ready and ridge_gap_percent < 0) or (ridge_direction < 0 and ridge_ready and ridge_gap_percent > 0)
        ridge_stop = (ridge_direction > 0 and close <= strategy.position_avg_price * 0.95) or (ridge_direction < 0 and close >= strategy.position_avg_price * 1.05)
        if ridge_converged or ridge_invalid or ridge_stop or ridge_holding_bars >= max_hold_bars
            strategy.close(id="ridge_trade")
            ridge_direction := 0
            ridge_holding_bars := 0
else if strategy.position_size == 0
    strategy.entry(id="core", direction=strategy.long, notional=strategy.equity * core_equity_percent / 100)

plot(ridge, title="iv_ridge", precision=2, overlay=true)
plot(ridge_gap_percent, title="ridge_gap_percent", precision=2)
plot(fast_ema, title="fast_ema", precision=2, overlay=true)
plot(slow_ema, title="slow_ema", precision=2, overlay=true)
plot(rsi, title="rsi", precision=2)
plot(len(ridge_strikes), title="ridge_expiry_count", precision=0)
plot(ridge_holding_bars, title="ridge_holding_bars", precision=0)